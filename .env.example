# Salin ke .env dan isi. JANGAN PERNAH commit .env ke git.

# --- Wallet Base Network ---
# Private key wallet/sub-account khusus bot (tanpa 0x prefix boleh).
# Mode paper: boleh kosong — bot akan memakai random dummy wallet.
# Mode testnet/live: WAJIB diisi. Jangan pakai wallet utama.
BASE_PRIVATE_KEY=

# --- Telegram alert (opsional tapi direkomendasikan) ---
# Buat bot via @BotFather, ambil chat id via @userinfobot / getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard web (opsional tapi sangat direkomendasikan untuk akses publik) ---
# Token proteksi /api/* dan /ws. Wajib diisi bila web.bind bukan 127.0.0.1.
# Buat yang kuat: openssl rand -hex 32
DASHBOARD_TOKEN=

# Level log: trace|debug|info|warn|error
RUST_LOG=info
