# Salin ke .env dan isi. JANGAN PERNAH commit .env ke git.

# --- Akun MASTER (yang disalin) ---
# Wajib: READ-ONLY key (permission: Enable Reading saja, tanpa trading/withdrawal).
MASTER_API_KEY=
MASTER_API_SECRET=

# --- Akun FOLLOWER (akun Anda) ---
# Hanya dipakai mode testnet/live. Wajib: withdrawal OFF, IP whitelist ON,
# permission spot only, sebaiknya di SUB-AKUN khusus bot.
FOLLOWER_API_KEY=
FOLLOWER_API_SECRET=

# --- Telegram alert (opsional tapi direkomendasikan) ---
# Buat bot via @BotFather, ambil chat id via @userinfobot / getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard web (opsional) ---
# Token proteksi /api/*. Wajib diisi bila web.bind bukan 127.0.0.1.
# Buat yang kuat: openssl rand -hex 32
DASHBOARD_TOKEN=

# Level log: trace|debug|info|warn|error
RUST_LOG=info
