# Template deployment Docker — Base Network only.
# Salin menjadi config/production.yaml (file tersebut diabaikan Git).
#
# Bind dashboard WAJIB 0.0.0.0:8080 DI DALAM container agar terjangkau
# docker-proxy; Compose hanya mempublikasikannya ke 127.0.0.1:8080 host dan
# Caddy meneruskan TLS dari crybot.dna-server.cloud.
#
# Keamanan API: isi DASHBOARD_TOKEN di .env. Bila terisi, semua /api/*
# wajib header `Authorization: Bearer <token>`.
mode: paper

risk:
  daily_loss_limit_pct: "3"
  kill_switch_drawdown_pct: "10"
  # Biarkan false sampai validasi paper/testnet selesai.
  armed: false

monitor:
  telegram_bot_token_env: TELEGRAM_BOT_TOKEN
  telegram_chat_id_env: TELEGRAM_CHAT_ID
  alert_on_fill: true
  commands_enabled: true

store:
  sqlite_path: data/events.db

web:
  enabled: true
  bind: "0.0.0.0:8080"

base:
  ws_url: "wss://base-flashblocks.coinbase.com/v1/ws/base"
  http_url: "https://mainnet.base.org"
  flashblocks: true
  mev_rpc_url: null
  # Poll reserve V2-compatible -> PoolSync. Default satu pool/detik agar
  # aman untuk endpoint RPC publik; tingkatkan hanya setelah ukur rate limit.
  pool_sync_poll_interval_ms: 1000
  pool_sync_batch_size: 1
  # Biarkan kosong pada production paper. Testnet memakai daftar factory
  # eksplisit di config/testnet.yaml yang terpisah.
  factory_addresses: []
  private_key_env: BASE_PRIVATE_KEY

strategies:
  sniper:
    enabled: false
    max_buy_eth: "0.05"
    min_liquidity_eth: "1.0"
    auto_tp_pct: "50"
    auto_sl_pct: "20"
    # Simulator V2 read-only; tetap nonaktif dan tidak pernah broadcast transaksi.
    paper_simulation:
      enabled: false
      poll_interval_ms: 5000
      amm_fee_bps: 30
      entry_exit_gas_eth: "0.0001"
    # Tidak digunakan pada production paper. Mode live mainnet tetap diblokir.
    testnet_execution:
      enabled: false
      routes: []
      slippage_bps: 300
      deadline_secs: 60
      max_entries_per_run: 1
    safety:
      check_honeypot: true
      check_ownership_renounced: true
      check_lp_locked: false
      check_holder_distribution: true
      max_holder_pct: "5"

  copy_onchain:
    enabled: false
    # Memantau transaksi confirmed dari wallet target; tetap observe-only,
    # tidak membuat BaseOrder atau broadcast transaksi.
    wallet_tx_poll_interval_ms: 1000
    slippage_bps: 300
    sizing: fixed_ratio
    copy_ratio: "0.1"
    min_tx_eth: "0.01"
    max_tx_eth: "1.0"
    target_wallets: []

  # Source harga yang mengirim PriceTick. Harga selalu quote_token per
  # base_token setelah normalisasi decimals. `kind` dapat berupa v2,
  # uniswap_v3, atau aerodrome_slipstream; daftar default tetap kosong.
  price_feed_poll_interval_ms: 1000
  price_feed_batch_size: 1
  price_feeds: []

  grid_dca:
    enabled: false
    grids: []
    dca_plans: []

  arbitrage:
    enabled: false
    min_profit_eth: "0.001"
    max_gas_gwei: 5
    monitored_pools: []

  yield_farming:
    enabled: false
    auto_compound_interval_hours: 6
    min_fee_threshold_eth: "0.001"
    positions: []

  perps:
    enabled: false
    max_leverage: 10
    exchange_router: null
    reader: null
    positions: []
